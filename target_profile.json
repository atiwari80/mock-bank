{
  "name": "mock bank",
  "repair": {
    "strategy": "maven-java",
    "root": ".",
    "editable_roots": [
      "middleware/src/main/java"
    ],
    "serve_command": "java -jar middleware/target/middleware-0.1.0.jar --server.port={port}",
    "options": {}
  },
  "build": {
    "strategy": "maven-java",
    "root": "middleware",
    "build_command": "mvn -q -B -DskipTests package",
    "test_command": "mvn -q -B test",
    "options": {
      "image": "maven:3.9-eclipse-temurin-17"
    }
  },
  "vcs": {
    "strategy": "git-local",
    "root": ".",
    "default_branch": "main",
    "branch_prefix": "testpilot/",
    "options": {}
  }
}
